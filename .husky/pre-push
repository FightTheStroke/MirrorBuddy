#!/usr/bin/env bash
set -euo pipefail

# === CRITICAL GATES: Unit Tests + Debt + Vercel Sim ===
# Typecheck is intentionally omitted here — pre-push-vercel.sh runs a full
# production build which includes type checking. Avoids redundant double-check.

# i18n validation (unconditional - ensures translation consistency)
npm run i18n:check || exit 1

# Check for duplicate commit messages in last 5 commits. Excludes generic
# merge-sync commits: GitHub's PR update-branch API legitimately produces one
# per re-sync against a moving base, so the same message repeating is expected
# noise, not an accidental duplicate commit — the check's actual target.
# Both spellings occur: "Merge branch 'main' into X" and, from the API,
# "Merge remote-tracking branch 'origin/main' into X".
DUPLICATE_COMMITS=$(git log --oneline -5 | awk '{$1=""; print $0}' | grep -v "^ Merge \(remote-tracking \)\?branch '.*' into " | sort | uniq -d)
if [ -n "$DUPLICATE_COMMITS" ]; then
  echo "ERROR: Duplicate commit messages found in last 5 commits:"
  echo "$DUPLICATE_COMMITS"
  echo ""
  echo "Each commit should have a unique message. Use git rebase -i to edit."
  exit 1
fi

# Audit environment variables (ensures all process.env.X are documented)
./scripts/env-var-audit.sh || exit 1

# Bound local process fan-out on shared machines without skipping any tests.
echo "Running unit tests..."
unit_log=$(mktemp "${TMPDIR:-/tmp}/mirrorbuddy-pre-push-unit.XXXXXX")
if npm run test:unit -- --reporter=dot --maxWorkers=2 >"$unit_log" 2>&1; then
  tail -5 "$unit_log"
  rm -- "$unit_log"
else
  unit_status=$?
  tail -80 "$unit_log"
  echo "Unit tests failed. Fix failing tests before pushing."
  echo "Full unit test output: $unit_log"
  exit "$unit_status"
fi

# Technical debt check (PR-level gate, not per-commit)
if command -v npx >/dev/null 2>&1; then
  npx tsx scripts/debt-check.ts 2>/dev/null || {
    echo "Technical debt thresholds exceeded. Run: npm run debt:check"
    exit 1
  }
fi

./scripts/pre-push-vercel.sh
