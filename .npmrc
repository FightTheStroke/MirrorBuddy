# Pin the registry the lockfile was resolved against. Without this, a global
# ~/.npmrc pointing at a corporate mirror makes `pnpm install` fail with
# ERR_PNPM_FETCH_404 on packages the mirror has not cached. Packages are pinned
# by integrity hash, so the registry choice cannot change what is installed.
# Override with: npm_config_registry=<url> pnpm install
registry=https://registry.npmjs.org/
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
node-linker=hoisted
