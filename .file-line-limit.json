{
  "maxLines": 250,
  "directories": [
    "apps/web/src",
    "packages",
    "scripts",
    ".claude",
    "docs",
    "apps/web/e2e",
    "@docs"
  ],
  "extensions": [".ts", ".tsx", ".js", ".jsx", ".sh", ".md"],
  "excludePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/generated/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "exemptFiles": [
    "CHANGELOG.md",
    "TROUBLESHOOTING.md",
    "scripts/ci-summary.sh",
    "scripts/release-brutal.sh"
  ]
}
